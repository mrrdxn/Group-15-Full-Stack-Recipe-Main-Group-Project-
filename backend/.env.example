# Copy this file to .env and fill in real values. Never commit .env.
PORT=5001
NODE_ENV=development
# Neon connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require
# Optional: public URL of the deployed API. Only needed if src/config/cron.js reads API_URL.
# API_URL=https://your-api.example.com
